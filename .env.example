# core-api environment template.
#
# Comments sit on their own lines on purpose: systemd's EnvironmentFile keeps
# an inline "# note" as part of the value, where dotenv would strip it.
#
# [required]  the service will not start, or its routes answer 503, without it
# [default]   leave empty for the built-in default
# [tunable]   safe to change per environment
# [frozen]    must match prod: ratings are not comparable across values

# [required]
CIV_SAVE_PARSER_VERSION=dev
# [required] for /season-new: the folder a season change saves to
SEASON_BACKUP_DIR=
# [optional] set at the cutover: reports uploaded before it auto-approve no sooner than 48 hours after it
AUTO_APPROVE_START=
# [required]
MONGO_URL=mongodb://localhost
# [tunable]
MONGODB_TIMEOUT_MS=
MONGODB_MAX_POOL_SIZE=
MONGODB_MIN_POOL_SIZE=

# [default]
API_HOST=
API_PORT=

# [required] LJ has no default: import fails if it is unset
LJ_SERVICE_TOKEN=
# [required] each of these routes answers 503 while its token is unset
AUTH_SERVICE_TOKEN=
MITO_SERVICE_TOKEN=

# [required]
AUTH_DISCORD_CLIENT_ID=
AUTH_DISCORD_CLIENT_SECRET=
AUTH_DISCORD_REDIRECT_URI=
AUTH_STEAM_API_KEY=
# [default]
AUTH_SESSION_TTL_MINUTES=5
AUTH_OAUTH_TIMEOUT_SECONDS=15
AUTH_STEAM_TIMEOUT_SECONDS=15
AUTH_STEAM_CIV6_APP_ID=289070
AUTH_STEAM_CIV7_APP_ID=1295660
AUTH_STEAM_CIV6_REQUIRED_MINUTES=2880
AUTH_STEAM_CIV7_REQUIRED_MINUTES=120

# [frozen] CPL games do not draw, so TS_DRAW_PROB stays 0
TS_MU=1200
TS_SIGMA=150
TS_BETA=400
TS_TAU=10
TS_DRAW_PROB=0

# [default]
MIN_POINTS_FOR_SUBS=
TEAM_GEN_TRIES=
TEAM_GEN_RANDOMNESS=
