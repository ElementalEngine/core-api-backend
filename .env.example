# core-api environment template. Copy to .env and fill in the required values.
#
# Comments sit on their own lines on purpose: systemd's EnvironmentFile keeps
# an inline "# note" as part of the value, where dotenv would strip it.
# A commented line shows its default; uncomment it only to change it. An empty
# value is not the default: a number left empty stops the service starting.
#
# [required]  the service will not start, or its routes answer 503, without it
# [optional]  off or empty until set
# [tunable]   safe to change per environment
# [frozen]    must match prod: ratings are not comparable across values

# [required] the Atlas cluster; MONGO_URI is read too
MONGO_URL=mongodb://localhost:27017
# [tunable]
# MONGODB_TIMEOUT_MS=5000
# MONGODB_MAX_POOL_SIZE=100
# MONGODB_MIN_POOL_SIZE=0

# [tunable] where uvicorn listens
# API_HOST=127.0.0.1
# API_PORT=8000

# [required] Lady Justice's token: startup fails without it
LJ_SERVICE_TOKEN=
# [required] the bot's routes answer 503 while its token is unset
AUTH_SERVICE_TOKEN=
MITO_SERVICE_TOKEN=

# [required] for registration: Discord OAuth and the Steam Web API
AUTH_DISCORD_CLIENT_ID=
AUTH_DISCORD_CLIENT_SECRET=
AUTH_DISCORD_REDIRECT_URI=
AUTH_STEAM_API_KEY=
# [tunable]
# AUTH_SESSION_TTL_MINUTES=5
# AUTH_OAUTH_TIMEOUT_SECONDS=5
# AUTH_STEAM_TIMEOUT_SECONDS=5
# AUTH_STEAM_CIV6_APP_ID=289070
# AUTH_STEAM_CIV7_APP_ID=1295660
# AUTH_STEAM_CIV6_REQUIRED_MINUTES=2880
# AUTH_STEAM_CIV7_REQUIRED_MINUTES=120

# [required] for /season-new: the folder a season change saves its backup to
SEASON_BACKUP_DIR=
# [optional] set once, at the cutover, as an ISO time (a time without a zone is
# UTC): reports uploaded before it auto-approve no sooner than 48 hours after it
# AUTO_APPROVE_START=2026-11-01T18:00:00Z
# [optional] stamped on each parsed match, so a record says which parser read it
# CIV_SAVE_PARSER_VERSION=1.0

# [frozen] CPL games do not draw, so TS_DRAW_PROB stays 0
# TS_MU=1200
# TS_SIGMA=150
# TS_BETA=400
# TS_TAU=10
# TS_DRAW_PROB=0
# [frozen] the least a sub-in gains
# MIN_POINTS_FOR_SUBS=5

# [tunable] /teamgen: shuffles tried, and how much better a later one must be to win
# TEAM_GEN_TRIES=10
# TEAM_GEN_RANDOMNESS=0.05
